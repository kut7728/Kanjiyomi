{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kanjiyomi"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanjiyomi uses the camera to photograph Japanese flyers and signs so it can recognize the words in them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日本語のチラシや看板を撮影して単語を認識するために、カメラへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일본어 전단지·간판을 촬영해 단어를 인식하기 위해 카메라 접근이 필요합니다."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanjiyomi loads photos from your library so it can recognize Japanese words in them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アルバムから写真を読み込んで日本語の単語を認識するために、写真へのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앨범에서 사진을 불러와 일본어 단어를 인식하기 위해 사진 접근이 필요합니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
}